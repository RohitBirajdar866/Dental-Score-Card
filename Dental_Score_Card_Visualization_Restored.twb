          <datasource-dependencies datasource="sqlproxy.0eneto615tqdth1c3x5um1evrgid">
            <column caption="M0 Oral Evaluation" datatype="real" default-format="p0%" name="[Calculation_1545297672479629313]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_0] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_0] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="M1 Dental &amp; Medical History" datatype="real" default-format="p0%" name="[Calculation_1545297672483598338]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_1] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_1] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="M2 Periodontal Screening" datatype="real" default-format="p0%" name="[Calculation_1545297672485199875]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_2] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_2] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
