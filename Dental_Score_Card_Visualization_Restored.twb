    <worksheet name="Exec - How to Decide">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontalignment="1" fontsize="10">How to Decide</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Dental Score Card Live RLS" name="sqlproxy.0eneto615tqdth1c3x5um1evrgid"/>
            <datasource name="Parameters"/>
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="Compliance Target" datatype="real" default-format="p0%" name="[Parameter 9500000000000001]" param-domain-type="range" role="measure" type="quantitative" value="0.9">
              <calculation class="tableau" formula="0.9"/>
              <range granularity="0.05" max="1.0" min="0.5"/>
            </column>
            <column caption="Provider Coaching Threshold" datatype="real" default-format="p0%" name="[Parameter 9500000000000002]" param-domain-type="range" role="measure" type="quantitative" value="0.8">
              <calculation class="tableau" formula="0.8"/>
              <range granularity="0.05" max="1.0" min="0.5"/>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="sqlproxy.0eneto615tqdth1c3x5um1evrgid">
            <column caption="Total Patients" datatype="integer" name="[Calculation_1545297672466853888]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNTD([MRN])"/>
            </column>
            <column caption="M0 Oral Evaluation" datatype="real" default-format="p0%" name="[Calculation_1545297672479629313]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_0] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_0] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="M1 Dental &amp; Medical History" datatype="real" default-format="p0%" name="[Calculation_1545297672483598338]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_1] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_1] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="M2 Periodontal Screening" datatype="real" default-format="p0%" name="[Calculation_1545297672485199875]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_2] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_2] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="M3 Oral Health Education" datatype="real" default-format="p0%" name="[Calculation_1545297672487002116]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_3] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_3] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="M4 Tobacco Cessation" datatype="real" default-format="p0%" name="[Calculation_1545297672488787973]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_4] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_4] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="M5 Dental Plan Created" datatype="real" default-format="p0%" name="[Calculation_1545297672496918534]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#13;&#10;    IF [MET_5] = &quot;Met&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [MET_5] IN (&quot;Met&quot;, &quot;Not Met&quot;)&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)"/>
            </column>
            <column caption="Overall Compliance %" datatype="real" default-format="p0%" name="[Calculation_1545297672522280967]" role="measure" type="quantitative">
              <calculation class="tableau" formula="(&#13;&#10;    [Calculation_1545297672479629313]&#13;&#10;    + [Calculation_1545297672483598338]&#13;&#10;    + [Calculation_1545297672485199875]&#13;&#10;    + [Calculation_1545297672487002116]&#13;&#10;    + [Calculation_1545297672488787973]&#13;&#10;    + [Calculation_1545297672496918534]&#13;&#10;) / 6"/>
            </column>
            <column caption="Measure Failures (Not Met)" datatype="integer" name="[Calculation_9500000000000000001]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [MET_0] = &quot;Not Met&quot; THEN 1 ELSE 0 END)&#10;+ SUM(IF [MET_1] = &quot;Not Met&quot; THEN 1 ELSE 0 END)&#10;+ SUM(IF [MET_2] = &quot;Not Met&quot; THEN 1 ELSE 0 END)&#10;+ SUM(IF [MET_3] = &quot;Not Met&quot; THEN 1 ELSE 0 END)&#10;+ SUM(IF [MET_4] = &quot;Not Met&quot; THEN 1 ELSE 0 END)&#10;+ SUM(IF [MET_5] = &quot;Not Met&quot; THEN 1 ELSE 0 END)"/>
            </column>
            <column caption="Largest Opportunities (Names)" datatype="string" name="[Calculation_9500000000000000032]" role="measure" type="nominal">
              <calculation class="tableau" formula="MID(&#10;(IF [Calculation_1545297672479629313] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672483598338] &lt; [Calculation_1545297672479629313] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672485199875] &lt; [Calculation_1545297672479629313] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672487002116] &lt; [Calculation_1545297672479629313] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672488787973] &lt; [Calculation_1545297672479629313] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672496918534] &lt; [Calculation_1545297672479629313] THEN 1 ELSE 0 END)) &lt;= 1 THEN &quot;, M0 Oral Evaluation&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672483598338] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672479629313] &lt; [Calculation_1545297672483598338] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672485199875] &lt; [Calculation_1545297672483598338] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672487002116] &lt; [Calculation_1545297672483598338] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672488787973] &lt; [Calculation_1545297672483598338] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672496918534] &lt; [Calculation_1545297672483598338] THEN 1 ELSE 0 END)) &lt;= 1 THEN &quot;, M1 Dental &amp; Medical History&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672485199875] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672479629313] &lt; [Calculation_1545297672485199875] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672483598338] &lt; [Calculation_1545297672485199875] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672487002116] &lt; [Calculation_1545297672485199875] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672488787973] &lt; [Calculation_1545297672485199875] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672496918534] &lt; [Calculation_1545297672485199875] THEN 1 ELSE 0 END)) &lt;= 1 THEN &quot;, M2 Periodontal Screening&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672487002116] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672479629313] &lt; [Calculation_1545297672487002116] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672483598338] &lt; [Calculation_1545297672487002116] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672485199875] &lt; [Calculation_1545297672487002116] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672488787973] &lt; [Calculation_1545297672487002116] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672496918534] &lt; [Calculation_1545297672487002116] THEN 1 ELSE 0 END)) &lt;= 1 THEN &quot;, M3 Oral Health Education&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672488787973] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672479629313] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672483598338] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672485199875] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672487002116] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672496918534] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END)) &lt;= 1 THEN &quot;, M4 Tobacco Cessation&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672496918534] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672479629313] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672483598338] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672485199875] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672487002116] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672488787973] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END)) &lt;= 1 THEN &quot;, M5 Dental Plan Created&quot; ELSE &quot;&quot; END),&#10;3)"/>
            </column>
            <column caption="Providers Below Coaching Threshold" datatype="integer" name="[Calculation_9500000000000000034]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM({ INCLUDE [Most Recent Dental Provider] : IF [Calculation_1545297672522280967] &lt; [Parameters].[Parameter 9500000000000002] THEN 1 ELSE 0 END })"/>
            </column>
            <column caption="Providers Evaluated" datatype="integer" name="[Calculation_9500000000000000035]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNTD([Most Recent Dental Provider])"/>
            </column>
            <column caption="How to Decide - Big Picture Takeaway" datatype="string" name="[Calculation_9500000000000000040]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF ZN([Calculation_1545297672466853888]) = 0 THEN &quot;No patients match the current filters.&quot;&#10;ELSEIF ISNULL([Calculation_1545297672522280967]) THEN &quot;Overall compliance is unavailable because a measure has no eligible patients in this selection.&quot;&#10;ELSEIF [Calculation_1545297672522280967] &gt;= [Parameters].[Parameter 9500000000000001] THEN &quot;We are at or above the &quot; + IFNULL(STR(INT(ROUND(([Parameters].[Parameter 9500000000000001]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot; target. Sustain what is working.&quot;&#10;ELSEIF [Calculation_1545297672522280967] &gt;= 0.75 THEN &quot;We are close to the &quot; + IFNULL(STR(INT(ROUND(([Parameters].[Parameter 9500000000000001]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot; target, with room to improve compliance.&quot;&#10;ELSE &quot;We are serving many patients, but there is significant room to improve compliance against the &quot; + IFNULL(STR(INT(ROUND(([Parameters].[Parameter 9500000000000001]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot; target.&quot;&#10;END"/>
            </column>
            <column caption="How to Decide - What's Working" datatype="string" name="[Calculation_9500000000000000041]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF ZN([Calculation_1545297672466853888]) = 0 THEN &quot;&quot;&#10;ELSEIF LEN(MID(&#10;(IF [Calculation_1545297672479629313] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M0 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672479629313]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Oral Evaluation&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672483598338] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M1 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672483598338]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Dental &amp; Medical History&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672485199875] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M2 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672485199875]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Periodontal Screening&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672487002116] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M3 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672487002116]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Oral Health Education&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672488787973] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M4 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672488787973]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Tobacco Cessation&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672496918534] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M5 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672496918534]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Dental Plan Created&quot; ELSE &quot;&quot; END),&#10;2)) = 0 THEN &quot;No measure is at target yet.&quot;&#10;ELSE MID(&#10;(IF [Calculation_1545297672479629313] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M0 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672479629313]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Oral Evaluation&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672483598338] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M1 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672483598338]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Dental &amp; Medical History&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672485199875] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M2 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672485199875]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Periodontal Screening&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672487002116] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M3 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672487002116]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Oral Health Education&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672488787973] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M4 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672488787973]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Tobacco Cessation&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672496918534] &gt;= [Parameters].[Parameter 9500000000000001] THEN CHAR(10) + &quot;M5 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672496918534]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Dental Plan Created&quot; ELSE &quot;&quot; END),&#10;2)&#10;END"/>
