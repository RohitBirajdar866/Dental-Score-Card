      <aliases enabled="yes"/>
      <column aggregation="Count" datatype="string" default-type="nominal" layered="true" name="[CITY]" pivot="key" role="dimension" semantic-role="[City].[Name]" type="nominal" user-datatype="string" visual-totals="Default"/>
      <column caption="Ops Bottom Line Text" datatype="string" name="[Calculation_ops_bottom]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ZN(COUNTD([MRN])) = 0 THEN &quot;No patients match the current filters. Adjust State or City.&quot; ELSE STR(COUNTD([MRN])) + &quot; patients had a recent dental visit with no open episode. That is the gap the quality scorecard does not show. Open the Episode Gap List tab, download the MRNs, and start an episode. Close or assign open dental encounters, starting with the oldest aging bucket. Kept visits and unique patients are how busy the panel is, not how complete care is.&quot; END"/>
      </column>
      <column caption="Ops Keep" datatype="string" name="[Calculation_ops_keep]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ([Parameters].[Parameter Ops State] = &quot;All&quot; OR [STATE] = [Parameters].[Parameter Ops State]) AND ([Parameters].[Parameter Ops City] = &quot;All&quot; OR [CITY] = [Parameters].[Parameter Ops City]) AND ([Parameters].[Parameter Ops Provider] = &quot;All&quot; OR CONTAINS(UPPER([VISIT_PROVIDER]), UPPER([Parameters].[Parameter Ops Provider]))) THEN &quot;Keep&quot; ELSE &quot;Drop&quot; END"/>
      </column>
      <column caption="Patients No Episode" datatype="integer" name="[Calculation_ops_noe_cnt]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([MRN])"/>
      </column>
