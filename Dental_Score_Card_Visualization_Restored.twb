            <column caption="Matching Normal Provider" datatype="string" name="[Calculation_0014113950732308]" role="dimension" type="nominal">
              <calculation class="tableau" formula="{ FIXED [Calculation_0014113950941205] :&#10;    MIN(&#10;        IF NOT CONTAINS([VISIT PROVIDER], &quot;DBLBK&quot;) THEN [VISIT PROVIDER] END&#10;    )&#10;}"/>
