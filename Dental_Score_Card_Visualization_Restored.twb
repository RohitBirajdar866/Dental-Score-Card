          <calculation class="tableau" formula="IF [MET_0] = &quot;Not Met&quot; OR [MET_1] = &quot;Not Met&quot; OR [MET_2] = &quot;Not Met&quot; OR [MET_3] = &quot;Not Met&quot; OR [MET_4] = &quot;Not Met&quot; OR [MET_5] = &quot;Not Met&quot; THEN &quot;Not Met&quot; ELSE &quot;Other&quot; END"/>
