      <column caption="Visit Providers" datatype="string" name="[Calculation_0014113950629907]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF CONTAINS([VISIT PROVIDER], &quot;DBLBK&quot;) THEN&#10;    [Calculation_0014113950732308]&#10;ELSE&#10;    [VISIT PROVIDER]&#10;END"/>
      </column>
      <column caption="Matching Normal Provider" datatype="string" name="[Calculation_0014113950732308]" role="dimension" type="nominal">
        <calculation class="tableau" formula="{ FIXED [Calculation_0014113950941205] :&#10;    MIN(&#10;        IF NOT CONTAINS([VISIT PROVIDER], &quot;DBLBK&quot;) THEN [VISIT PROVIDER] END&#10;    )&#10;}"/>
      </column>
      <column caption="Provider Last Name" datatype="string" name="[Calculation_0014113950941205]" role="dimension" type="nominal">
        <calculation class="tableau" formula="TRIM(&#10;    REPLACE(&#10;        REPLACE(SPLIT([VISIT PROVIDER], &quot; &quot;, 1), &quot;DBLBK&quot;, &quot;&quot;), &#10;        &quot;,&quot;,&#10;        &quot;&quot;&#10;    )&#10;)"/>
      </column>
      <column caption="2025 " datatype="boolean" name="[Calculation_0014184772456461]" role="dimension" type="nominal">
        <calculation class="tableau" formula="YEAR([VISIT DATE]) = 2025"/>
      </column>
      <column caption="FPL%" datatype="string" name="[Calculation_0014803207880774]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [FPL] &lt; 100 THEN &quot;1. Below FPL&quot;&#10;ELSEIF [FPL] &lt; 139 THEN &quot;2. 100 - 138&quot;&#10;ELSEIF [FPL] &lt; 201 THEN &quot;3. 139 - 200&quot;&#10;ELSEIF [FPL] &lt; 251 THEN &quot;4. 201 - 250&quot;&#10;ELSEIF [FPL] &lt; 301 THEN &quot;5. 251 - 300&quot;&#10;ELSEIF [FPL] &lt; 351 THEN &quot;6. 301 - 350&quot;&#10;ELSEIF [FPL] &lt; 401 THEN &quot;7. 351 - 400&quot;&#10;ELSEIF [FPL] &lt; 501 THEN &quot;8. 401 - 500&quot;&#10;ELSE &quot;9. 500+&quot;&#10;END"/>
      </column>
      <column caption="MRN Sum" datatype="integer" name="[Calculation_0014803211919433]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([MRN])"/>
      </column>
      <column caption="Total Visits Historical" datatype="integer" name="[Calculation_6210182437495328769]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNT(IF [APPT_STATUS] = 'Kept'&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END)"/>
      </column>
      <column caption="Total Patients Historical" datatype="integer" name="[Calculation_6210182437496082434]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([MRN])"/>
      </column>
      <column caption="Ops Keep" datatype="string" name="[Calculation_ops_keep]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ([Parameters].[Parameter Ops State] = &quot;All&quot; OR [STATE] = [Parameters].[Parameter Ops State]) AND ([Parameters].[Parameter Ops City] = &quot;All&quot; OR [CITY] = [Parameters].[Parameter Ops City]) AND ([Parameters].[Parameter Ops Site] = &quot;All&quot; OR [DEPARTMENT_NAME] = [Parameters].[Parameter Ops Site]) AND ([Parameters].[Parameter Ops Provider] = &quot;All&quot; OR CONTAINS(UPPER([VISIT PROVIDER]), UPPER([Parameters].[Parameter Ops Provider]))) THEN &quot;Keep&quot; ELSE &quot;Drop&quot; END"/>
      </column>
      <column caption="Unique Patients Historical" datatype="integer" name="[Calculation_ops_pats_hist]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(IF [APPT_STATUS] = 'KEPT' THEN [MRN] END)"/>
      </column>
      <column caption="Kept Visits Historical" datatype="integer" name="[Calculation_ops_vis_hist]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [APPT_STATUS] = 'KEPT' THEN 1 ELSE 0 END)"/>
      </column>
      <column caption="Kept Visits 12mo" datatype="integer" name="[Calculation_ops_vis_kept]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [APPT_STATUS] = 'KEPT' AND DATEDIFF('month', [VISIT DATE], TODAY()) &lt;= 12 THEN 1 ELSE 0 END)"/>
      </column>
      <column caption="Unique Patients 12mo" datatype="integer" name="[Calculation_ops_vis_pats]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(IF [APPT_STATUS] = 'KEPT' AND DATEDIFF('month', [VISIT DATE], TODAY()) &lt;= 12 THEN [MRN] END)"/>
      </column>
