      <column aggregation="Count" datatype="string" default-type="nominal" layered="true" name="[CITY]" pivot="key" role="dimension" semantic-role="[City].[Name]" type="nominal" user-datatype="string" visual-totals="Default"/>
      <column aggregation="Year" datatype="date" default-type="ordinal" layered="true" name="[CONTACT_DATE]" pivot="key" role="dimension" type="ordinal" user-datatype="date" visual-totals="Default"/>
      <column caption="Visit ID" datatype="string" name="[Calculation_0014803215482954]" role="dimension" type="nominal">
        <calculation class="tableau" formula="STR([PAT_ENC_CSN_ID])"/>
      </column>
      <column caption="Visit Providers" datatype="string" name="[Calculation_0014803215958091]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF CONTAINS([VISIT_PROVIDER], &quot;DBLBK&quot;) THEN&#10;    [Calculation_0014803216031820]&#10;ELSE&#10;    [VISIT_PROVIDER]&#10;END"/>
      </column>
      <column caption="Matching Normal Provider" datatype="string" default-role="measure" default-type="quantitative" name="[Calculation_0014803216031820]" role="dimension" type="nominal">
        <calculation class="tableau" formula="{ FIXED [Calculation_0014803216085069] :&#10;    MIN(&#10;        IF NOT CONTAINS([VISIT_PROVIDER], &quot;DBLBK&quot;) THEN [VISIT_PROVIDER] END&#10;    )&#10;}"/>
      </column>
      <column caption="Provider Last Name" datatype="string" name="[Calculation_0014803216085069]" role="dimension" type="nominal">
        <calculation class="tableau" formula="TRIM(&#10;    REPLACE(&#10;        REPLACE(SPLIT([VISIT_PROVIDER], &quot; &quot;, 1), &quot;DBLBK&quot;, &quot;&quot;), &#10;        &quot;,&quot;,&#10;        &quot;&quot;&#10;    )&#10;)"/>
      </column>
      <column caption="Length of Time Open" datatype="string" name="[Calculation_0014803216355406]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [BUS_DAYS] &gt;= 365 AND [BUS_DAYS] &lt; 730 THEN &quot;1-2 years&quot;&#10;ELSEIF [BUS_DAYS] &gt;= 730 AND [BUS_DAYS] &lt; 1095 THEN &quot;2-3 years&quot;&#10;ELSEIF [BUS_DAYS] &gt;= 1095 THEN &quot;3+ years&quot;&#10;ELSEIF [BUS_DAYS] &gt;= 90 AND [BUS_DAYS] &lt; 365 THEN &quot;90 days - 1 year&quot;&#10;ELSEIF [BUS_DAYS] &gt;= 1 AND [BUS_DAYS] &lt; 90 THEN &quot;1-90 days&quot;&#10;&#10;END"/>
      </column>
      <column caption="Length of Time Open" datatype="string" name="[Calculation_ops_enc_age]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [BUS_DAYS] &gt;= 1095 THEN &quot;3+ years&quot; ELSEIF [BUS_DAYS] &gt;= 730 THEN &quot;2-3 years&quot; ELSEIF [BUS_DAYS] &gt;= 365 THEN &quot;1-2 years&quot; ELSEIF [BUS_DAYS] &gt;= 90 THEN &quot;90 days - 1 year&quot; ELSE &quot;1-90 days&quot; END"/>
      </column>
      <column caption="Open Dental Encounters" datatype="integer" name="[Calculation_ops_enc_cnt]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(STR([PAT_ENC_CSN_ID]))"/>
      </column>
      <column caption="Ops Keep" datatype="string" name="[Calculation_ops_keep]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ([Parameters].[Parameter Ops State] = &quot;All&quot; OR [STATE] = [Parameters].[Parameter Ops State]) AND ([Parameters].[Parameter Ops City] = &quot;All&quot; OR [CITY] = [Parameters].[Parameter Ops City]) AND ([Parameters].[Parameter Ops Site] = &quot;All&quot; OR [DEPARTMENT_NAME] = [Parameters].[Parameter Ops Site]) AND ([Parameters].[Parameter Ops Provider] = &quot;All&quot; OR CONTAINS(UPPER([VISIT_PROVIDER]), UPPER([Parameters].[Parameter Ops Provider]))) AND ([Parameters].[Parameter Ops Enc Age] = &quot;All&quot; OR [Calculation_ops_enc_age] = [Parameters].[Parameter Ops Enc Age]) THEN &quot;Keep&quot; ELSE &quot;Drop&quot; END"/>
      </column>
