alculation_1545297672487002116]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Oral Health Education&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672488787973] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672479629313] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672483598338] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672485199875] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672487002116] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672496918534] &lt; [Calculation_1545297672488787973] THEN 1 ELSE 0 END)) &lt;= 2 THEN CHAR(10) + &quot;M4 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672488787973]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Tobacco Cessation&quot; ELSE &quot;&quot; END)&#10;+ (IF [Calculation_1545297672496918534] &lt; [Parameters].[Parameter 9500000000000001] AND ((IF [Calculation_1545297672479629313] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672483598338] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672485199875] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672487002116] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END) + (IF [Calculation_1545297672488787973] &lt; [Calculation_1545297672496918534] THEN 1 ELSE 0 END)) &lt;= 2 THEN CHAR(10) + &quot;M5 (&quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672496918534]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot;) – Dental Plan Created&quot; ELSE &quot;&quot; END),&#10;2)&#10;END"/>
