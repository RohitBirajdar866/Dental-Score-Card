      <column caption="How to Decide - Gaps Takeaway" datatype="string" name="[Calculation_9500000000000000043]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF LEN([Calculation_9500000000000000032]) = 0 THEN &quot;Keep monitoring monthly to sustain performance.&quot;&#10;ELSE &quot;Prioritize action plans, training, and reminders for these measures.&quot;&#10;END"/>
      </column>
      <column caption="How to Decide - Provider Focus" datatype="string" name="[Calculation_9500000000000000044]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ZN([Calculation_1545297672466853888]) = 0 THEN &quot;&quot;&#10;ELSE STR([Calculation_9500000000000000034]) + &quot; of &quot; + STR([Calculation_9500000000000000035]) + &quot; providers are below the &quot; + IFNULL(STR(INT(ROUND(([Parameters].[Parameter 9500000000000002]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot; coaching threshold. Providers below the threshold should be prioritized for coaching.&quot;&#10;END"/>
      </column>
      <column caption="Bottom Line Text" datatype="string" name="[Calculation_9500000000000000045]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ZN([Calculation_1545297672466853888]) = 0 THEN &quot;No patients match the current filters. Adjust Provider, State, City, Site, Year, Quarter or Month.&quot;&#10;ELSE &quot;Overall compliance is &quot; + IFNULL(STR(INT(ROUND(([Calculation_1545297672522280967]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot; against a &quot; + IFNULL(STR(INT(ROUND(([Parameters].[Parameter 9500000000000001]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot; target. &quot; + (IF LEN([Calculation_9500000000000000030]) &gt; 0 THEN &quot;Strong performance exists in &quot; + [Calculation_9500000000000000030] + &quot;. &quot; ELSE &quot;&quot; END) + (IF LEN([Calculation_9500000000000000032]) &gt; 0 THEN &quot;The largest opportunities are &quot; + [Calculation_9500000000000000032] + &quot;. &quot; ELSE &quot;All measures are at or above target. &quot; END) + &quot;Providers below the &quot; + IFNULL(STR(INT(ROUND(([Parameters].[Parameter 9500000000000002]) * 100, 0))) + &quot;%&quot;, &quot;n/a&quot;) + &quot; target should be prioritized for coaching and follow-up.&quot;&#10;END"/>
      </column>
      <column caption="Has Any Not Met" datatype="string" name="[Calculation_9500000000000000050]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [MET_0] = &quot;Not Met&quot; OR [MET_1] = &quot;Not Met&quot; OR [MET_2] = &quot;Not Met&quot; OR [MET_3] = &quot;Not Met&quot; OR [MET_4] = &quot;Not Met&quot; OR [MET_5] = &quot;Not Met&quot; THEN &quot;Not Met&quot; ELSE &quot;Other&quot; END"/>
      </column>
      <column caption="Measures Not Met" datatype="string" name="[Calculation_9500000000000000051]" role="dimension" type="nominal">
        <calculation class="tableau" formula="MID((IF [MET_0] = &quot;Not Met&quot; THEN &quot;, M0&quot; ELSE &quot;&quot; END) + (IF [MET_1] = &quot;Not Met&quot; THEN &quot;, M1&quot; ELSE &quot;&quot; END) + (IF [MET_2] = &quot;Not Met&quot; THEN &quot;, M2&quot; ELSE &quot;&quot; END) + (IF [MET_3] = &quot;Not Met&quot; THEN &quot;, M3&quot; ELSE &quot;&quot; END) + (IF [MET_4] = &quot;Not Met&quot; THEN &quot;, M4&quot; ELSE &quot;&quot; END) + (IF [MET_5] = &quot;Not Met&quot; THEN &quot;, M5&quot; ELSE &quot;&quot; END), 3)"/>
      </column>
      <column caption="Not Met Count" datatype="integer" name="[Calculation_9500000000000000052]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="(IF [MET_0] = &quot;Not Met&quot; THEN 1 ELSE 0 END) + (IF [MET_1] = &quot;Not Met&quot; THEN 1 ELSE 0 END) + (IF [MET_2] = &quot;Not Met&quot; THEN 1 ELSE 0 END) + (IF [MET_3] = &quot;Not Met&quot; THEN 1 ELSE 0 END) + (IF [MET_4] = &quot;Not Met&quot; THEN 1 ELSE 0 END) + (IF [MET_5] = &quot;Not Met&quot; THEN 1 ELSE 0 END)"/>
      </column>
      <column caption="Not Met Measure Dates" datatype="string" name="[Calculation_9500000000000000053]" role="dimension" type="nominal">
        <calculation class="tableau" formula="MID((IF [MET_0] = &quot;Not Met&quot; THEN &quot;, M0: &quot; + IFNULL([Oral Evaluation Date], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_1] = &quot;Not Met&quot; THEN &quot;, M1: &quot; + IFNULL([Dental and Medical History Procedure Date], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_2] = &quot;Not Met&quot; THEN &quot;, M2: &quot; + IFNULL([Periodontal Screening Date], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_3] = &quot;Not Met&quot; THEN &quot;, M3: &quot; + IFNULL([Oral Health Education Date], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_4] = &quot;Not Met&quot; THEN &quot;, M4: &quot; + IFNULL([Tobacco Screening Date], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_5] = &quot;Not Met&quot; THEN &quot;, M5: &quot; + IFNULL([Dental Plan Created Date], &quot;—&quot;) ELSE &quot;&quot; END), 3)"/>
      </column>
      <column caption="Not Met Responsible Providers" datatype="string" name="[Calculation_9500000000000000054]" role="dimension" type="nominal">
        <calculation class="tableau" formula="MID((IF [MET_0] = &quot;Not Met&quot; THEN &quot;, M0: &quot; + IFNULL([Oral Evaluation Provider], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_1] = &quot;Not Met&quot; THEN &quot;, M1: &quot; + IFNULL([Dental and Medical History Provider], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_2] = &quot;Not Met&quot; THEN &quot;, M2: &quot; + IFNULL([Periodontal Screening Provider], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_3] = &quot;Not Met&quot; THEN &quot;, M3: &quot; + IFNULL([Oral Health Education Provider], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_4] = &quot;Not Met&quot; THEN &quot;, M4: &quot; + IFNULL([Tobacco Screening Provider], &quot;—&quot;) ELSE &quot;&quot; END) + (IF [MET_5] = &quot;Not Met&quot; THEN &quot;, M5: &quot; + IFNULL([Dental Plan Provider], &quot;—&quot;) ELSE &quot;&quot; END), 3)"/>
      </column>
